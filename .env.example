# ============================================
# Pasaporte Digital - Configuración de Entorno
# ============================================
# 1) COPIA este archivo como ".env" (el original NO se modifica)
# 2) Reemplaza el valor de ejemplo por TU propia API Key de Google Maps
#    (ver sección "Tu propia API Key" en el README)
# 3) NUNCA subas tu .env al repositorio: ya está en .gitignore
#    Verifica con: git status

# Google Maps JavaScript API Key (OBLIGATORIO para rutas en el mapa)
# Requiere APIs habilitadas en Google Cloud: Maps JavaScript API + Directions API
# Con restricción de dominio (localhost:8501 en local o tu dominio en la nube)
MAPS_API_KEY=tu_api_key_aqui

# Ruta de la base de datos SQLite
# Vacío = busca automáticamente en la raíz del proyecto
# Ejemplo: DB_PATH=C:\ruta\a\mi\base.db
DB_PATH=
